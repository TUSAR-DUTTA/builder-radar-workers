{
  "name": "builderradar-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:infra": "docker-compose up -d",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "build": "npm run typecheck:workers && npm pack --dry-run",
    "start": "next start",
    "lint": "eslint src/workers contract-tests test scripts",
    "validate:consumer-ui:ingest": "tsx scripts/ingest-consumer-ui.ts",
    "workers:run": "tsx src/workers/runner.ts",
    "workers:watch": "tsx src/workers/runner.ts --watch",
    "typecheck:workers": "tsc --noEmit -p tsconfig.worker.json",
    "verify:evidence-contract": "node scripts/verify-evidence-contract.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test": "npm run test:worker-contracts && npm run test:worker-browser-contracts && npm run verify:workflows && npm run scan:secrets",
    "test:worker-contracts": "npm run typecheck:workers && node contract-tests/run-contract-tests.mjs",
    "test:worker-browser-contracts": "tsx test/run-worker-tests.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.5",
    "@builder-radar/evidence-contract": "file:vendor/builder-radar-evidence-contract-1.1.0.tgz",
    "@next/third-parties": "^16.2.7",
    "@qdrant/js-client-rest": "^1.18.0",
    "@supabase/supabase-js": "^2.106.1",
    "builderradar-app": "file:..",
    "cohere-ai": "^8.0.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.2.0",
    "hono": "^4.12.22",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "node-fetch": "^3.3.2",
    "playwright-extra": "^4.3.6",
    "postgres": "^3.4.9",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.55.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
